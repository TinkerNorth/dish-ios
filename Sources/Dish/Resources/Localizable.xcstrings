    "Local Network is off for Dish, so it can’t find Satellite or send input to your PC." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalna mreža je isključena za Dish, pa ne može pronaći Satellite niti slati unos vašem PC-ju."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokales Netzwerk ist für Dish ausgeschaltet, daher findet es Satellite nicht und kann keine Eingaben an deinen PC senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Red local está desactivada para Dish, así que no puede encontrar Satellite ni enviar entradas a tu PC."
