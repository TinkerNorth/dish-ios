    "Most disconnects come from Wi-Fi switching bands or the controller’s own wireless dropping." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Većina prekida dolazi od Wi-Fija koji mijenja pojas ili od pada bežične veze samog kontrolera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Verbindungsabbrüche entstehen, wenn das WLAN das Band wechselt oder die Funkverbindung des Controllers abreißt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de las desconexiones vienen de la Wi-Fi cambiando de banda o de la caída del inalámbrico del propio mando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des déconnexions viennent du Wi-Fi qui change de bande ou de la liaison sans fil de la manette qui lâche."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maioria das desconexões vem do Wi-Fi trocando de banda ou do próprio sem fio do controle caindo."
          }
        }
      }
    },
    "Motion" : {
      "localizations" : {
