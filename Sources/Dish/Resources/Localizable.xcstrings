    "For the iPhone-to-PC leg, Wi-Fi is the only way, so connect the PC to the router with Ethernet if you can." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na dionici iPhone–PC, Wi-Fi je jedini put, pa povežite PC na usmjerivač Ethernetom ako možete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf der Strecke iPhone-zu-PC ist WLAN der einzige Weg, verbinde den PC also nach Möglichkeit per Ethernet mit dem Router."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el tramo del iPhone al PC, el Wi-Fi es la única vía, así que conecta el PC al router con Ethernet si puedes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour le trajet iPhone-vers-PC, le Wi-Fi est le seul chemin, donc reliez le PC au routeur en Ethernet si vous le pouvez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No trecho do iPhone até o PC, o Wi-Fi é o único caminho, então ligue o PC ao roteador com Ethernet se puder."
          }
        }
      }
