    },
    "Dish sends input as small UDP packets over your local network, so a fast LAN keeps the delay tiny." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish šalje unos kao male UDP pakete preko vaše lokalne mreže, pa brz LAN drži kašnjenje minimalnim."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish schickt Eingaben als kleine UDP-Pakete über dein lokales Netzwerk, ein schnelles LAN hält die Verzögerung also winzig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish envía la entrada en paquetes UDP pequeños por tu red local, así que una LAN rápida mantiene el retardo mínimo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish envoie les entrées sous forme de petits paquets UDP sur votre réseau local, donc un réseau local rapide garde le délai minime."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dish envia a entrada como pequenos pacotes UDP pela sua rede local, então uma LAN rápida mantém o atraso mínimo."
          }
        }
      }
    },
    "Dish starts a session on this host as soon as a controller is bound to it." : {
      "comment" : "Banner body under Paired with.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish pokreće sesiju na ovom hostu čim se kontroler poveže s njim."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish startet auf diesem Host eine Sitzung, sobald ein Controller damit verbunden ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish inicia una sesión en este host en cuanto le asignas un mando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish démarre une session sur cet hôte dès que vous y associez une manette."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dish inicia uma sessão neste host assim que um controle for vinculado a ele."
          }
        }
      }
    },
    "Dish turns a controller paired with this iPhone, or the iPhone’s own screen, into a wireless gamepad for your PC." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
