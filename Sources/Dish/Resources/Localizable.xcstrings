    "While a controller is forwarded, Dish keeps the screen on and dims it instead of locking." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dok se kontroler prosljeđuje, Dish drži ekran uključenim i zatamnjuje ga umjesto zaključavanja."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange ein Controller weitergeleitet wird, hält Dish den Bildschirm an und dunkelt ihn ab, statt zu sperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras se reenvía un mando, Dish mantiene la pantalla encendida y la atenúa en lugar de bloquearla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant qu’une manette est transférée, Dish garde l’écran allumé et l’assombrit au lieu de le verrouiller."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto um controle é encaminhado, o Dish mantém a tela ligada e a escurece em vez de bloquear."
          }
        }
      }
    },
