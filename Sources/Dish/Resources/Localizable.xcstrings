    "iOS pauses apps you leave, so Dish stays open and dims itself instead of locking." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pauzira aplikacije koje napustite, pa Dish ostaje otvoren i zatamnjuje se umjesto da zaključa ekran."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pausiert Apps, die du verlässt, daher bleibt Dish geöffnet und dunkelt sich ab, statt zu sperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pausa las apps que dejas, así que Dish sigue abierto y se atenúa en lugar de bloquearse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS met en pause les apps que vous quittez, donc Dish reste ouvert et s’assombrit au lieu de se verrouiller."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS pausa os apps que você deixa, então o Dish fica aberto e escurece em vez de bloquear."
          }
        }
      }
