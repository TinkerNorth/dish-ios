    "Dish reads any controller iOS supports: DualSense, DualShock 4, Xbox Wireless and Switch Pro." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish čita svaki kontroler koji iOS podržava: DualSense, DualShock 4, Xbox Wireless i Switch Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish liest jeden Controller, den iOS unterstützt: DualSense, DualShock 4, Xbox Wireless und Switch Pro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish lee cualquier mando que iOS admita: DualSense, DualShock 4, Xbox Wireless y Switch Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish lit toute manette prise en charge par iOS : DualSense, DualShock 4, Xbox Wireless et Switch Pro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dish lê qualquer controle compatível com o iOS: DualSense, DualShock 4, Xbox Wireless e Switch Pro."
          }
        }
      }
    },
    "Dish sends input as small UDP packets over your local network, so a fast LAN keeps the delay tiny." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish šalje unos kao male UDP pakete preko vaše lokalne mreže, pa brz LAN drži kašnjenje minimalnim."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish schickt Eingaben als kleine UDP-Pakete über dein lokales Netzwerk, ein schnelles LAN hält die Verzögerung also winzig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish envía la entrada en paquetes UDP pequeños por tu red local, así que una LAN rápida mantiene el retardo mínimo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish envoie les entrées sous forme de petits paquets UDP sur votre réseau local, donc un réseau local rapide garde le délai minime."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dish envia a entrada como pequenos pacotes UDP pela sua rede local, então uma LAN rápida mantém o atraso mínimo."
          }
        }
      }
    },
    "Dish turns a controller paired with this iPhone, or the iPhone’s own screen, into a wireless gamepad for your PC." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish pretvara kontroler uparen s ovim iPhoneom, ili sam ekran iPhonea, u bežični gamepad za vaš PC."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish macht aus einem mit diesem iPhone gekoppelten Controller oder dem Bildschirm des iPhone selbst ein kabelloses Gamepad für deinen PC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish convierte un mando emparejado con este iPhone, o la propia pantalla del iPhone, en un mando inalámbrico para tu PC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish transforme une manette appairée à cet iPhone, ou l’écran de l’iPhone lui-même, en manette sans fil pour votre PC."
