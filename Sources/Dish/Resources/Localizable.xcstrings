    "Apps can’t pair Bluetooth devices, so Dish leaves that to iOS." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacije ne mogu uparivati Bluetooth uređaje, pa Dish to prepušta iOS-u."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps können keine Bluetooth-Geräte koppeln, daher überlässt Dish das iOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps no pueden emparejar dispositivos Bluetooth, así que Dish se lo deja a iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps ne peuvent pas appairer d’appareils Bluetooth, donc Dish laisse cela à iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps não podem parear dispositivos Bluetooth, então o Dish deixa isso para o iOS."
          }
        }
      }
    },
