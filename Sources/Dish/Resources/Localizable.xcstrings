        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dish pareia com o Satellite no seu PC e envia cada toque pela sua própria Wi‑Fi."
          }
        }
      }
    },
    "Dish reads any controller iOS supports: DualSense, DualShock 4, Xbox Wireless and Switch Pro." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish čita svaki kontroler koji iOS podržava: DualSense, DualShock 4, Xbox Wireless i Switch Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish liest jeden Controller, den iOS unterstützt: DualSense, DualShock 4, Xbox Wireless und Switch Pro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
