    "Microphone and controller speaker aren’t open to apps on iOS, so Dish leaves them out." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon i zvučnik kontrolera nisu dostupni aplikacijama na iOS‑u, pa ih Dish izostavlja."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon und Controller-Lautsprecher stehen Apps unter iOS nicht offen, deshalb lässt Dish sie weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono y el altavoz del mando no están disponibles para las apps en iOS, así que Dish los deja fuera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro et le haut-parleur de la manette ne sont pas accessibles aux apps sur iOS, Dish les laisse donc de côté."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
