    "Dish pairs with Satellite on your PC and sends every press over your own Wi‑Fi." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish se uparuje sa Satellite na vašem PC-ju i šalje svaki pritisak preko vašeg Wi‑Fi‑ja."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish koppelt sich mit Satellite auf deinem PC und sendet jeden Tastendruck über dein eigenes Wi‑Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish se empareja con Satellite en tu PC y envía cada pulsación por tu propia Wi‑Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish s’appaire avec Satellite sur votre PC et envoie chaque appui par votre propre Wi‑Fi."
