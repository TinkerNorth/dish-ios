          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob Satellite auf dem PC läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que Satellite esté en marcha en el PC."
          }
        },
