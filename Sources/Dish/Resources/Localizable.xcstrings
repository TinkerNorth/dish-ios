    "Check the digits right before you type, and make sure you’re pairing with the right Satellite if more than one is listed." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerite cifre neposredno prije unosa i pazite da se uparujete s ispravnim satelitom ako ih je navedeno više."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die Ziffern direkt vor der Eingabe und achte darauf, dass du dich mit dem richtigen Satellite koppelst, falls mehrere aufgelistet sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba los dígitos justo antes de escribirlos y asegúrate de que te emparejas con el Satellite correcto si aparece más de uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les chiffres juste avant de les saisir, et assurez-vous d'appairer le bon Satellite si plusieurs sont listés."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira os dígitos logo antes de digitar e verifique se está pareando com o satélite certo caso haja mais de um na lista."
          }
        }
      }
    },
