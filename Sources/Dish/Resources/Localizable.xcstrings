          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele encaminha a entrada pela sua rede local até o ajudante gratuito Satellite."
          }
        }
      }
    },
    "It has no analytics and no crash reporting." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema analitike niti izvještaja o padovima."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hat keine Analysen und keine Absturzberichte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tiene analíticas ni informes de fallos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’a ni statistiques d’usage ni rapports de plantage."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele não tem análises nem relatórios de falhas."
          }
        }
      }
    },
    "It receives input from Dish over Wi-Fi and presents itself to that PC’s games as a regular controller." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima unos iz Disha preko Wi-Fija i predstavlja se igrama na tom PC-u kao obični kontroler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es empfängt Eingaben von Dish über WLAN und meldet sich bei den Spielen dieses PCs als ganz normaler Controller an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe la entrada de Dish por Wi-Fi y se presenta ante los juegos de ese PC como un mando normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reçoit les entrées de Dish via Wi-Fi et se présente aux jeux de ce PC comme une manette ordinaire."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele recebe a entrada do Dish por Wi-Fi e se apresenta aos jogos daquele PC como um controle comum."
          }
        }
      }
    },
