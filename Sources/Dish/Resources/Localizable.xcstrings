    "iOS asks before any app looks for devices on your network." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pita prije nego bilo koja aplikacija potraži uređaje na vašoj mreži."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS fragt nach, bevor eine App nach Geräten in deinem Netzwerk sucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pregunta antes de que cualquier app busque dispositivos en tu red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS demande avant qu’une app cherche des appareils sur votre réseau."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS pergunta antes de qualquer app procurar dispositivos na sua rede."
          }
        }
      }
    },
    "iOS asks once whether Dish may use the local network, the first time Dish looks for your PC." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS jednom pita smije li Dish koristiti lokalnu mrežu, prvi put kada Dish traži vaš PC."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS fragt einmal, ob Dish das lokale Netzwerk nutzen darf, wenn Dish zum ersten Mal nach deinem PC sucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pregunta una vez si Dish puede usar la red local, la primera vez que Dish busca tu PC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS demande une seule fois si Dish peut utiliser le réseau local, la première fois que Dish cherche votre PC."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS pergunta uma vez se o Dish pode usar a rede local, na primeira vez que o Dish procura seu PC."
          }
        }
      }
    },
    "iOS only tells apps “iPhone”." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS aplikacijama govori samo “iPhone”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS sagt Apps nur „iPhone“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS solo dice a las apps “iPhone”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS dit seulement « iPhone » aux apps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS informa aos apps apenas “iPhone”."
          }
        }
      }
    },
    "iOS pauses apps you leave, so Dish stays open and dims itself instead of locking." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pauzira aplikacije koje napustite, pa Dish ostaje otvoren i zatamnjuje se umjesto da zaključa ekran."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pausiert Apps, die du verlässt, daher bleibt Dish geöffnet und dunkelt sich ab, statt zu sperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pausa las apps que dejas, así que Dish sigue abierto y se atenúa en lugar de bloquearse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS met en pause les apps que vous quittez, donc Dish reste ouvert et s’assombrit au lieu de se verrouiller."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS pausa os apps que você deixa, então o Dish fica aberto e escurece em vez de bloquear."
          }
        }
      }
    },
    "iOS suspends an app you leave, and a suspended Dish stops forwarding." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS suspenduje aplikaciju koju napustite, a suspendovan Dish prestaje prosljeđivati."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hält eine App an, die du verlässt, und ein angehaltenes Dish leitet nichts mehr weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS suspende la app que dejas, y un Dish suspendido deja de reenviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS suspend l’app que vous quittez, et un Dish suspendu cesse le transfert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS suspende o app que você deixa, e um Dish suspenso para de encaminhar."
          }
        }
      }
    },
