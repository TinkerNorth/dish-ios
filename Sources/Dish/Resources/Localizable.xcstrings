    "Dish lists every pad iOS supports and marks one it can’t read as Not supported." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish prikazuje svaki kontroler koji iOS podržava, a onaj koji ne može čitati označava kao Nije podržano."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish listet jeden Controller, den iOS unterstützt, und markiert einen, den es nicht lesen kann, als Nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish muestra cada mando que iOS admite y marca como No compatible el que no puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
