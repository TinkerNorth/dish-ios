    "A Moonlight host works without installing anything new, at a little more latency." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonlight host radi bez instaliranja ičega novog, uz malo veću latenciju."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Moonlight-Host funktioniert ohne neue Installation, mit etwas mehr Latenz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un host de Moonlight funciona sin instalar nada nuevo, con algo más de latencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un hôte Moonlight fonctionne sans rien installer de nouveau, avec un peu plus de latence."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um host Moonlight funciona sem instalar nada novo, com um pouco mais de latência."
          }
        }
      }
    },
    "A PC by address" : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC preko adrese"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein PC per Adresse"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un PC por dirección"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un PC par adresse"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um PC por endereço"
          }
        }
      }
    },
    "A controller last paired with another device, such as a console, has to be paired with this iPhone again." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroler koji je posljednji put uparen s drugim uređajem, poput konzole, mora se ponovo upariti s ovim iPhoneom."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Controller, der zuletzt mit einem anderen Gerät wie einer Konsole gekoppelt war, muss erneut mit diesem iPhone gekoppelt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mando emparejado por última vez con otro dispositivo, como una consola, tiene que emparejarse de nuevo con este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une manette appairée en dernier à un autre appareil, comme une console, doit être appairée de nouveau à cet iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um controle pareado por último com outro dispositivo, como um console, precisa ser pareado de novo com este iPhone."
          }
        }
      }
    },
    "A pad paired to this iPhone in Settings › Bluetooth." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroler uparen s ovim iPhoneom u Postavke › Bluetooth."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Controller, der in Einstellungen › Bluetooth mit diesem iPhone gekoppelt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mando emparejado con este iPhone en Ajustes › Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une manette appairée à cet iPhone dans Réglages › Bluetooth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um controle pareado com este iPhone em Ajustes › Bluetooth."
          }
        }
      }
    },
    "A tip pays for the time that goes into Dish and Satellite." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napojnica plaća vrijeme uloženo u Dish i Satellite."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Trinkgeld bezahlt die Zeit, die in Dish und Satellite fließt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una propina paga el tiempo que se dedica a Dish y Satellite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pourboire paie le temps consacré à Dish et Satellite."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma gorjeta paga o tempo dedicado ao Dish e ao Satellite."
          }
        }
      }
    },
