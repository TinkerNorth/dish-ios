    "Motion (gyro aim) isn’t working." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokret (žiro nišanjenje) ne radi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung (Gyro-Zielen) funktioniert nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El movimiento (puntería con giro) no funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mouvement (visée gyro) ne fonctionne pas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O movimento (mira giroscópica) não está funcionando."
          }
        }
      }
    },
    "Motion is a controller’s gyroscope used as aim assist, forwarded as the gyro inside a PlayStation pad." : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokret je žiroskop kontrolera koji se koristi kao pomoć pri nišanjenju i prosljeđuje se kao žiro unutar PlayStation pada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung ist das Gyroskop eines Controllers als Zielhilfe, weitergeleitet als das Gyro in einem PlayStation-Pad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El movimiento es el giroscopio de un mando usado como ayuda de puntería, reenviado como el giro que hay dentro de un mando PlayStation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mouvement, c'est le gyroscope d'une manette utilisé comme aide à la visée, transmis comme le gyro d'une manette PlayStation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimento é o giroscópio de um controle usado como auxílio de mira, encaminhado como o giroscópio de dentro de um controle PlayStation."
          }
        }
      }
    },
    "Motion needs three things: a Satellite connection, a controller with a gyroscope (DualSense, DualShock 4, Switch Pro)," : {
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za pokret su potrebne tri stvari: Satellite veza, kontroler sa žiroskopom (DualSense, DualShock 4, Switch Pro)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung braucht drei Dinge: eine Satellite-Verbindung, einen Controller mit Gyroskop (DualSense, DualShock 4, Switch Pro)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El movimiento necesita tres cosas: una conexión Satellite, un mando con giroscopio (DualSense, DualShock 4, Switch Pro)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mouvement nécessite trois choses : une connexion Satellite, une manette dotée d'un gyroscope (DualSense, DualShock 4, Switch Pro)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O movimento precisa de três coisas: uma conexão Satellite, um controle com giroscópio (DualSense, DualShock 4, Switch Pro)"
          }
        }
      }
    },
