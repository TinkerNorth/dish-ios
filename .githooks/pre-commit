#!/bin/bash
# Dish iOS pre-commit hook: runs SwiftFormat (autofix) and SwiftLint (check)
# on staged Swift files only. It prefers the pinned release binaries
# scripts/ci-local.sh fetches into .build/tools (the versions CI runs) and
# falls back to the ones on PATH; it skips when neither exists, so a fresh
# clone is never blocked. CI enforces the same checks in strict mode.
set -euo pipefail

# Collect staged .swift files (added / copied / modified), NUL-separated to
# handle paths with spaces.
staged=$(git diff --cached --name-only --diff-filter=ACM -z -- '*.swift' | tr '\0' '\n' | sed '/^$/d')
if [ -z "$staged" ]; then
    exit 0
fi

format_ok=1
lint_ok=1

# The pinned copies first: Homebrew tracks the newest release, whose rules
# the pins may not know.
PATH="$PWD/.build/tools:$PATH"

# ── SwiftFormat ──────────────────────────────────────────────────────────
if command -v swiftformat >/dev/null 2>&1; then
    echo "▶ swiftformat (staged files)"
    echo "$staged" | while IFS= read -r file; do
        swiftformat "$file"
        git add "$file"
    done
else
    echo "⚠  swiftformat not installed — skipping (run scripts/ci-local.sh once to fetch the pinned copy)"
fi

# ── SwiftLint ────────────────────────────────────────────────────────────
if command -v swiftlint >/dev/null 2>&1; then
    echo "▶ swiftlint (staged files)"
    # --use-script-input-files lets SwiftLint lint only the staged subset.
    export SCRIPT_INPUT_FILE_COUNT=0
    while IFS= read -r file; do
        eval "export SCRIPT_INPUT_FILE_${SCRIPT_INPUT_FILE_COUNT}=\"$PWD/$file\""
        SCRIPT_INPUT_FILE_COUNT=$((SCRIPT_INPUT_FILE_COUNT + 1))
    done <<<"$staged"
    export SCRIPT_INPUT_FILE_COUNT
    if ! swiftlint lint --use-script-input-files --quiet --strict; then
        lint_ok=0
    fi
else
    echo "⚠  swiftlint not installed — skipping (run scripts/ci-local.sh once to fetch the pinned copy)"
fi

if [ "$format_ok" -eq 0 ] || [ "$lint_ok" -eq 0 ]; then
    echo
    echo "✗ pre-commit failed — fix the issues above and re-stage."
    exit 1
fi
